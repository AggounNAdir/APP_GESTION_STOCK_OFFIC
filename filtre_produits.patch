+    def _unite_correspond(filtre, unite):
+        """Règle UNIQUE du filtre d'unité (tableau, impression et exports)."""
+        filtre = (filtre or "tous").strip().lower()
+        unite = (unite or "").strip().lower()
+        if filtre == "tous":
+            return True
+        if filtre == "kg":
+            return "kg" in unite
+        if filtre == "carton":
+            return "cart" in unite
+        return filtre == unite
+
+    def _maj_unites_disponibles(self, rows):
+        """Complète la liste « Filtrer unité » avec les unités réellement utilisées (Pièce, L, ...)."""
+        base = ["Tous", "kg", "carton", "Pcs"]
+        vues = {b.lower() for b in base}
+        autres = []
+        for r in rows:
+            u = (r["unite"] or "").strip()
+            bas = u.lower()
+            if u and bas not in vues and "kg" not in bas and "cart" not in bas:
+                vues.add(bas)
+                autres.append(u)
+        self.invent_filter_cb["values"] = base + sorted(autres, key=str.lower)
