+        self.kpi_sor, self.kpi_sor_sub = self._kpi(kf, "SORTIES (unités de base)", CLR_RED)
+        self.kpi_net, self.kpi_net_sub = self._kpi(kf, "SOLDE NET", CLR_ORANGE)
+
+        self.info_var = tk.StringVar(value="")
